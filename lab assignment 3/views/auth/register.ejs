<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Create Account</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f4f6f9; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .box { background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); width: 100%; max-width: 400px; }
        .group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: bold; }
        input, select { width: 100%; padding: 10px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; }
        .btn { background: #6F4E37; color: white; border: none; padding: 10px; width: 100%; border-radius: 4px; font-size: 16px; cursor: pointer; }
        .alert { color: red; margin-bottom: 15px; font-weight: bold; }
    </style>
</head>
<body>
    <div class="box">
        <h2>Join Second Cup</h2>
        
        <% if (error && error.length > 0) { %>
            <div class="alert"><%= error %></div>
        <% } %>

        <form action="/register" method="POST">
            <div class="group">
                <label>Full Name</label>
                <input type="text" name="name" required>
            </div>
            <div class="group">
                <label>Email Address</label>
                <input type="email" name="email" required>
            </div>
            <div class="group">
                <label>Password (6+ characters)</label>
                <input type="password" name="password" required minlength="6">
            </div>
            <div class="group">
                <label>Account Assignment Role (Testing Purposes)</label>
                <select name="role">
                    <option value="customer">Customer (Regular Access)</option>
                    <option value="admin">Admin (Full Dashboard Control)</option>
                </select>
            </div>
            <button type="submit" class="btn">Register</button>
        </form>
        <p style="margin-top:15px; text-align:center;"><a href="/login">Already have an account? Login</a></p>
    </div>
</body>
</html>